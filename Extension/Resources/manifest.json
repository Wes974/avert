{
  "manifest_version": 3,
  "name": "Impostor",
  "version": "0.1",
  "description": "Alerte quand une page réclame une identité qui ne correspond pas à son domaine. 100 % on-device.",
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
