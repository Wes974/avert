{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "fr",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
